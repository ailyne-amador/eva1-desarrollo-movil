DATABASE_URL="postgresql://eva1:eva1_dev@localhost:5433/tasks?schema=public"
# Reemplazar por un secreto aleatorio de al menos 32 caracteres.
JWT_SECRET=
# Duración del access token (ej. 15m, 1h). Se recomienda mantenerlo corto.
JWT_ACCESS_EXPIRES_IN=15m
# Duración del refresh token (ej. 7d, 30d). Acepta un número seguido de 'd'.
JWT_REFRESH_EXPIRES_IN=7d
